{
  "name": "mestre-20-perguntas",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "validate:data": "node --import tsx scripts/validate-data.ts",
    "benchmark": "node --import tsx scripts/benchmark.ts",
    "lab:ci": "node --import tsx scripts/autonomous-lab.ts --ci --output=reports/ci",
    "lab:nightly": "node --import tsx scripts/autonomous-lab.ts --output=reports/nightly"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.0",
    "vitest": "^4.0.0"
  }
}
